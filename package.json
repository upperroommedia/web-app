{
  "name": "web-app",
  "description": "Upper Room Media Web App",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    ".",
    "functions"
  ],
  "scripts": {
    "build-functions": "cd functions && pnpm build",
    "build-functions-watch": "cd functions && pnpm build-watch",
    "next-dev": "next dev --turbopack & pnpm run start-emulators",
    "start-emulators": "pnpm run build-functions-watch & firebase emulators:start --import=./dir",
    "dev": "pnpm kill-port 8081 9099 4000 3000 5001 9000 8123 && pnpm run next-dev",
    "create-dev-admin": "npx ts-node --skip-project scripts/create-dev-admin.ts",
    "analyze": "ANALYZE=true next build",
    "kill-port": "kill-port",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "style:all": "tsc && pnpm run style:lint && pnpm run style:prettier",
    "style:lint": "eslint '**/*.{js,jsx,ts,tsx}' --ignore-path .gitignore",
    "style:prettier": "prettier --check '**/*.{js,jsx,ts,tsx}' --ignore-path .gitignore",
    "make-pretty": "prettier --write '**/*.{js,jsx,ts,tsx}' --ignore-path .gitignore",
    "import-from-prod": "gsutil rm -r gs://urm-app.appspot.com/firestore_export && gcloud firestore export gs://urm-app.appspot.com/firestore_export && gsutil -m cp -r gs://urm-app.appspot.com/firestore_export ./dir"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@firebase/app-types": "^0.9.0",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@mui/system": "^7.1.1",
    "@mui/utils": "^7.1.1",
    "@mui/x-date-pickers": "^8.5.1",
    "@vidstack/react": "^1.12.13",
    "algoliasearch": "^5.27.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "firebase": "^9.23.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.6.0",
    "fuse.js": "^7.0.0",
    "instantsearch.js": "^4.78.3",
    "media-icons": "^1.0.0",
    "next": "15.3.8",
    "nextjs-progressbar": "^0.0.16",
    "nookies": "^2.5.2",
    "react": "19.1.0",
    "react-animate-height": "^3.2.3",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.2.3",
    "react-easy-crop": "^4.7.5",
    "react-error-boundary": "^4.0.12",
    "react-fast-marquee": "^1.6.3",
    "react-firebase-hooks": "^5.1.1",
    "react-image-crop": "^10.1.8",
    "react-infinite-scroll-component": "^6.1.0",
    "react-instantsearch": "^7.15.8",
    "react-social-login-buttons": "^4.1.1",
    "sharp": "^0.33.5",
    "tmp": "^0.2.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@firebase/firestore-types": "^3.0.0",
    "@firebase/rules-unit-testing": "^2.0.7",
    "@jest/globals": "^29.7.0",
    "@mui/types": "^7.2.13",
    "@next/bundle-analyzer": "15.3.8",
    "@next/eslint-plugin-next": "15.3.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^18.19.7",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/styled-components": "^5.1.34",
    "@types/tmp": "^0.2.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.8",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-mui": "^0.1.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "mocha": "^10.2.0",
    "prettier": "^2.8.8",
    "prop-types": "^15.8.1",
    "ts-jest": "^29.1.1",
    "typescript": "^4.9.5"
  },
  "pnpm": {
    "overrides": {
      "@google-cloud/storage": "7.13.0",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6",
      "algoliasearch": "5.27.0"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "ffmpeg-static",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "engines": {
    "node": "22"
  }
}
