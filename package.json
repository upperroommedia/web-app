{
  "name": "web-app",
  "description": "Upper Room Media Web App",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    ".",
    "functions",
    "functions-core",
    "functions-media",
    "functions-image",
    "functions-integrations"
  ],
  "scripts": {
    "build-functions": "pnpm run build-functions-codebases",
    "build-functions-watch": "pnpm run build-functions-codebases-watch",
    "build-functions-codebases": "pnpm --dir functions-core build && pnpm --dir functions-media build && pnpm --dir functions-image build && pnpm --dir functions-integrations build",
    "build-functions-codebases-watch": "turbo run build-watch --filter=functions-core --filter=functions-media --filter=functions-image --filter=functions-integrations --continue --ui=tui",
    "check:function-startup-loads": "node scripts/check-function-startup-loads.mjs",
    "app-dev": "next dev",
    "emulators": "node scripts/ensure-emulator-import-dirs.mjs && node scripts/start-emulators.mjs",
    "dev:core": "pnpm kill-port 8081 9099 4000 3000 5001 9000 8123 9199 && turbo run app-dev --filter=web-app --continue --ui=tui",
    "dev": "node scripts/dev.mjs",
    "setup:env": "node scripts/setup.mjs",
    "create-dev-admin": "pnpm exec ts-node --skip-project --compiler-options '{\"module\":\"commonjs\"}' scripts/create-dev-admin.ts",
    "analyze": "ANALYZE=true next build",
    "kill-port": "kill-port",
    "build": "next build",
    "build:all": "turbo run build:ci --continue",
    "build:ci": "next build",
    "test": "turbo run test:ci --continue",
    "test:ci": "pnpm run test:frontend:unit",
    "test:frontend:unit": "pnpm exec jest utils --config jest.config.js",
    "start": "next start",
    "lint": "turbo run lint:ci --continue",
    "lint:ci": "pnpm run style:lint",
    "style:all": "tsc && pnpm run style:lint && pnpm run style:prettier",
    "style:lint": "eslint .",
    "style:prettier": "prettier --check '**/*.{js,jsx,ts,tsx}' --ignore-path .gitignore",
    "make-pretty": "prettier --write '**/*.{js,jsx,ts,tsx}' --ignore-path .gitignore",
    "import-from-prod": "gsutil rm -r gs://urm-app.appspot.com/firestore_export && gcloud firestore export gs://urm-app.appspot.com/firestore_export && gsutil -m cp -r gs://urm-app.appspot.com/firestore_export ./dir",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@firebase/app-types": "^0.9.3",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@mui/system": "^7.1.1",
    "@mui/utils": "^7.1.1",
    "@mui/x-date-pickers": "^8.5.1",
    "@vidstack/react": "^1.12.13",
    "algoliasearch": "catalog:",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.2",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "firebase-tools": "^15.9.0",
    "fuse.js": "^7.0.0",
    "instantsearch.js": "^4.78.3",
    "media-icons": "^1.0.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nextjs-progressbar": "^0.0.16",
    "nookies": "^2.5.2",
    "react": "19.2.4",
    "react-animate-height": "^3.2.3",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.2.3",
    "react-easy-crop": "^4.7.5",
    "react-error-boundary": "^4.0.12",
    "react-fast-marquee": "^1.6.3",
    "react-firebase-hooks": "^5.1.1",
    "react-image-crop": "^10.1.8",
    "react-infinite-scroll-component": "^6.1.0",
    "react-instantsearch": "^7.15.8",
    "react-social-login-buttons": "^4.1.1",
    "sharp": "^0.33.5",
    "tmp": "^0.2.5",
    "uuid": "^9.0.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@firebase/firestore-types": "^3.0.3",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@jest/globals": "^29.7.0",
    "@mui/types": "^7.2.13",
    "@next/bundle-analyzer": "16.1.6",
    "@next/eslint-plugin-next": "16.1.6",
    "@playwright/test": "^1.58.0",
    "@types/jest": "^29.5.11",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/styled-components": "^5.1.34",
    "@types/tmp": "^0.2.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-mui": "^0.1.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "catalog:",
    "kill-port": "^2.0.1",
    "mocha": "^10.2.0",
    "prettier": "^2.8.8",
    "prop-types": "^15.8.1",
    "ts-jest": "^29.1.1",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@google-cloud/storage": "7.19.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "algoliasearch": "5.27.0",
      "@tootallnate/once": "3.0.1",
      "cookie": "0.7.0",
      "fast-xml-parser": "4.5.4",
      "preact": "10.28.4",
      "qs": "6.15.0",
      "tar": "7.5.10",
      "undici": "6.23.0"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "ffmpeg-static",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "engines": {
    "node": "22"
  }
}
