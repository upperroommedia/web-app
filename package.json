{
  "name": "upper-room-media-workspace",
  "description": "Upper Room Media monorepo workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run build:packages",
    "build:packages": "pnpm --dir packages/shared build && pnpm --dir packages/contracts build",
    "build-functions": "pnpm run build-functions-codebases",
    "build-functions-watch": "pnpm run build-functions-codebases-watch",
    "build-functions-codebases": "pnpm --dir functions-core build && pnpm --dir functions-media build && pnpm --dir functions-image build && pnpm --dir functions-integrations build",
    "build-functions-codebases-watch": "node scripts/watch-functions.mjs",
    "functions-watch": "pnpm run build-functions-codebases-watch",
    "check:function-startup-loads": "node scripts/check-function-startup-loads.mjs",
    "emulators": "node scripts/ensure-emulator-import-dirs.mjs && node scripts/start-emulators.mjs",
    "dev:core": "pnpm kill-port 8081 9099 4000 3000 5001 9000 8123 9199 && turbo run app-dev --filter=web-app --continue --ui=tui",
    "dev": "node scripts/dev.mjs",
    "setup:env": "node scripts/setup.mjs",
    "create-dev-admin": "pnpm exec ts-node --skip-project --compiler-options '{\"module\":\"commonjs\"}' scripts/create-dev-admin.ts",
    "analyze": "pnpm --dir apps/web run analyze",
    "kill-port": "kill-port",
    "build": "pnpm run build:packages && pnpm --dir apps/web run build",
    "build:all": "turbo run build:ci --continue",
    "build:ci": "pnpm run build:packages && pnpm --dir apps/web run build:ci",
    "test": "turbo run test:ci --continue",
    "test:ci": "pnpm --dir apps/web run test:ci",
    "test:frontend:unit": "pnpm --dir apps/web run test:frontend:unit",
    "start": "pnpm --dir apps/web run start",
    "lint": "turbo run lint:ci --continue",
    "lint:ci": "pnpm --dir apps/web run lint:ci",
    "style:all": "pnpm --dir apps/web run style:all",
    "style:lint": "pnpm --dir apps/web run style:lint",
    "style:prettier": "pnpm --dir apps/web run style:prettier",
    "make-pretty": "pnpm --dir apps/web run make-pretty",
    "import-from-prod": "gsutil rm -r gs://urm-app.appspot.com/firestore_export && gcloud firestore export gs://urm-app.appspot.com/firestore_export && gsutil -m cp -r gs://urm-app.appspot.com/firestore_export ./dir",
    "test:e2e": "pnpm --dir apps/web run test:e2e",
    "test:e2e:headed": "pnpm --dir apps/web run test:e2e:headed"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "catalog:",
    "firebase-admin": "catalog:",
    "firebase-tools": "^15.9.0",
    "kill-port": "^2.0.1",
    "mocha": "^10.2.0",
    "tsc-alias": "^1.8.16",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@google-cloud/storage": "7.19.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "algoliasearch": "5.27.0",
      "@tootallnate/once": "3.0.1",
      "cookie": "0.7.0",
      "fast-xml-parser": "4.5.4",
      "preact": "10.28.4",
      "qs": "6.15.0",
      "tar": "7.5.10",
      "undici": "6.23.0"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "ffmpeg-static",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "engines": {
    "node": "22"
  }
}
