{
  "functions": [
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-core",
      "codebase": "core",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-media",
      "codebase": "media",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-image",
      "codebase": "image",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-integrations",
      "codebase": "integrations",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9100
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 18081
    },
    "storage": {
      "port": 9199
    },
    "database": {
      "port": 19000
    },
    "tasks": {
      "port": 8123
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
