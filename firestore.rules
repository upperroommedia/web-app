rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
    	return request.auth != null && request.auth.token.role == 'admin';
    }
    
    function canUpload() {
    	return request.auth != null && (request.auth.token.role == 'uploader' || request.auth.token.role == 'admin' || request.auth.token.role == 'publisher');
    }

    function isAuthorized() {
      return request.auth != null;
    }

    function sermonIsProcessing() {
      return resource != null &&
        'status' in resource.data &&
        resource.data.status is map &&
        'audioStatus' in resource.data.status &&
        resource.data.status.audioStatus in ['PENDING', 'PROCESSING'];
    }

    function sermonClientUpdateAllowed() {
      return !sermonIsProcessing();
    }

    match /users/{userId} {
      allow read, write: if isAuthorized();
    }

    match /images/{document} {
      allow read: if isAuthorized();
      allow write: if (canUpload());
    }
    
    match /lists/{document} {
      allow read: if isAuthorized();
      allow write: if (canUpload());
    }
    
    match /speakers/{document} {
      allow read: if isAuthorized();
      allow write: if (isAdmin());
    }
    
    match /subtitles/{document} {
      allow read: if isAuthorized();
      allow write: if (isAdmin());
    }
    
    match /topics/{document} {
      allow read: if isAuthorized();
      allow write: if (canUpload());
    }
    
    match /transcriptions/{document} {
      allow read: if isAuthorized();
      allow write: if (canUpload());
    }
    
    // Series permissions: only owner or admin can access
    match /series/{seriesId} {
      // Admins can read/write all series
      allow read, write: if isAdmin();
      // Owners can read/write their own series
      allow read, write: if canUpload() && resource.data.ownerId == request.auth.uid;
      // Allow create if user can upload (they become the owner)
      allow create: if canUpload() && request.resource.data.ownerId == request.auth.uid;
      
      // Series items subcollection - same ownership rules
      match /seriesItems/{itemId} {
        allow read, write: if isAdmin();
        allow read, write: if canUpload() && get(/databases/$(database)/documents/series/$(seriesId)).data.ownerId == request.auth.uid;
      }
    }
    
    
    // Sermon permissions: Admins have full access, uploaders/publishers can only access their own sermons
    match /sermons/{sermonId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() && sermonClientUpdateAllowed();
      allow read, update: if canUpload() && 'uploaderId' in resource.data && resource.data.uploaderId == request.auth.uid && sermonClientUpdateAllowed();
      allow delete: if canUpload() && 'uploaderId' in resource.data && resource.data.uploaderId == request.auth.uid && (resource.data.status.soundCloud != 'UPLOADED' && resource.data.status.subsplash != 'UPLOADED');
      allow create: if canUpload();
    }

    // Bundle metadata - allow public read access for bundle timestamp checking
    // These documents only contain timestamps and counts, not sensitive data
    match /metadata/{bundleDoc} {
      allow read: if true;  // Public read access for bundle metadata
      allow write: if false; // Only server functions can write metadata
    }

    // Collection Groups
    match /{path=**}/sermonLists/{sermonListId} {
      allow read: if isAuthorized();
      allow write: if (canUpload());
    }
    match /{path=**}/listItems/{listItemId} {
      allow read: if isAuthorized();
      allow write: if (canUpload());
    }
  }
}
