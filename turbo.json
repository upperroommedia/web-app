{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "app-dev": {
      "cache": false,
      "persistent": true,
      "with": ["web-app#emulators", "functions#build-watch"]
    },
    "emulators": {
      "cache": false,
      "persistent": true
    },
    "build-watch": {
      "cache": false,
      "persistent": true
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "outputs": [".next/**", "!.next/cache/**", "lib/**"]
    },
    "lint:ci": {
      "dependsOn": ["^lint:ci"],
      "outputs": []
    },
    "test:ci": {
      "cache": false,
      "outputs": []
    }
  }
}
