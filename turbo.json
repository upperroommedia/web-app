{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "app-dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "functions-core#build",
        "functions-media#build",
        "functions-image#build",
        "functions-integrations#build"
      ],
      "with": [
        "//#emulators",
        "functions-core#build-watch",
        "functions-media#build-watch",
        "functions-image#build-watch",
        "functions-integrations#build-watch",
        "//#process-audio"
      ]
    },
    "//#process-audio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PROCESS_AUDIO_FILE_HOST_PORT",
        "PROCESS_AUDIO_YOUTUBE_HOST_PORT"
      ]
    },
    "//#emulators": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SKIP_FUNCTIONS_BUILD",
        "FIREBASE_PROJECT_ID",
        "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
        "EMULATE_EXTENSIONS",
        "EMULATE_APPHOSTING"
      ]
    },
    "build-watch": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "lib/**"
      ]
    },
    "build:ci": {
      "dependsOn": [
        "^build:ci"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "lib/**"
      ]
    },
    "lint:ci": {
      "dependsOn": [
        "^lint:ci"
      ],
      "outputs": []
    },
    "test:ci": {
      "cache": false,
      "outputs": []
    },
    "@upperroom/shared#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "firebase/**/*.js",
        "firebase/**/*.d.ts",
        "types/**/*.js",
        "types/**/*.d.ts",
        "shared/**/*.js",
        "shared/**/*.d.ts",
        "context/**/*.js",
        "context/**/*.d.ts",
        "constants/**/*.js",
        "constants/**/*.d.ts"
      ]
    },
    "@upperroom/contracts#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "*.js",
        "*.d.ts"
      ]
    },
    "@upperroom/process-audio#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@upperroom/shared#build:ci": {
      "dependsOn": [
        "^build:ci"
      ],
      "outputs": [
        "firebase/**/*.js",
        "firebase/**/*.d.ts",
        "types/**/*.js",
        "types/**/*.d.ts",
        "shared/**/*.js",
        "shared/**/*.d.ts",
        "context/**/*.js",
        "context/**/*.d.ts",
        "constants/**/*.js",
        "constants/**/*.d.ts"
      ]
    },
    "@upperroom/contracts#build:ci": {
      "dependsOn": [
        "^build:ci"
      ],
      "outputs": [
        "*.js",
        "*.d.ts"
      ]
    },
    "@upperroom/process-audio#build:ci": {
      "dependsOn": [
        "^build:ci"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@upperroom/browser-fallback#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@upperroom/browser-fallback#build:ci": {
      "dependsOn": [
        "^build:ci"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
