{
  "name": "functions-core",
  "private": true,
  "main": "lib/functions-core/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node ../scripts/write-sentry-build-info.mjs functions/src/sentryBuildInfo.ts && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:ci": "pnpm run build",
    "build-watch": "concurrently --kill-others-on-fail --names tsc,alias --prefix '[{name}]' --prefix-colors 'blue,magenta' \"tsc -w --preserveWatchOutput -p tsconfig.json\" \"tsc-alias -w -p tsconfig.json\""
  },
  "dependencies": {
    "@sentry/node": "^10.47.0",
    "@google-cloud/functions-framework": "^3.2.0",
    "@google-cloud/storage": "7.19.0",
    "algoliasearch": "^5.27.0",
    "axios": "^1.16.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.1.1",
    "form-data": "^4.0.0",
    "google-auth-library": "^9.15.1",
    "headers": "^0.9.6",
    "https-proxy-agent": "^7.0.4",
    "image-size": "^1.1.1",
    "lodash": "^4.17.23",
    "mkdirp": "^2.1.6",
    "node-fetch": "3.3.0",
    "p-limit": "^6.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.7",
    "typescript": "^5.9.3"
  }
}
