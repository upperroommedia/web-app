{
  "name": "functions-core",
  "private": true,
  "main": "lib/functions-core/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && node ../scripts/write-sentry-build-info.mjs functions/src/sentryBuildInfo.ts && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:ci": "pnpm run build",
    "build-watch": "concurrently --kill-others-on-fail --names tsc,alias --prefix '[{name}]' --prefix-colors 'blue,magenta' \"tsc -w --preserveWatchOutput -p tsconfig.json\" \"tsc-alias -w -p tsconfig.json\""
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.2.0",
    "@google-cloud/storage": "8.4.0",
    "@sentry/node": "^11.7.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/common": "1.24.0",
    "algoliasearch": "^5.27.0",
    "axios": "^1.19.0",
    "fast-average-color-node": "3.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.1.1",
    "form-data": "^4.0.0",
    "google-auth-library": "^11.2.0",
    "headers": "^0.9.6",
    "https-proxy-agent": "^7.0.4",
    "image-size": "catalog:",
    "lodash": "^4.17.23",
    "mkdirp": "^2.1.6",
    "node-fetch": "3.3.0",
    "node-vibrant": "4.0.4",
    "p-limit": "^6.2.0",
    "sharp": "0.35.5",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^5.9.3"
  }
}
