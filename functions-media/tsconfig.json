{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "paths": {
      "@upperroom/contracts/*": [
        "../packages/contracts/*"
      ],
      "@upperroom/shared/*": [
        "../packages/shared/*"
      ]
    },
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src/**/*.ts",
    "../functions/src/**/*.ts",
    "../packages/shared/**/*.ts",
    "../packages/contracts/**/*.ts"
  ]
}
