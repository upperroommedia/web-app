{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build-watch": "tsc -w",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "test": "firebase emulators:exec --only firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit'",
    "test:verbose": "VERBOSE=1 firebase emulators:exec --only firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit'",
    "test:series-locking:long": "firebase emulators:exec --only firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit --runInBand --testTimeout=240000 src/test/series/reorderSeriesItems.test.ts src/test/series/bulkAddToSeries.crossCallableLocking.test.ts'",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.2.0",
    "@google-cloud/storage": "7.13.0",
    "algoliasearch": "^5.27.0",
    "axios": "^1.6.5",
    "buffer-image-size": "^0.6.4",
    "dotenv": "^16.3.1",
    "fast-average-color-node": "^3.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^9.23.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "google-auth-library": "^9.4.2",
    "headers": "^0.9.6",
    "https-proxy-agent": "^7.0.4",
    "image-size": "^1.1.1",
    "imagemagick": "^0.1.3",
    "lodash": "^4.17.21",
    "mkdirp": "^2.1.6",
    "node-fetch": "3.3.0",
    "node-vibrant": "^4.0.3",
    "p-limit": "^6.2.0",
    "sharp": "0.33.5",
    "uuidv4": "^6.2.13",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/imagemagick": "^0.0.31",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.17",
    "@types/node": "^18.19.7",
    "@types/node-fetch": "^2.6.11",
    "@types/qs": "^6.9.11",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.28.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase-functions-test": "^3.4.1",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^4.9.5"
  },
  "private": true
}
