{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build-watch": "tsc -w",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "test": "firebase emulators:exec --only firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit'",
    "test:verbose": "VERBOSE=1 firebase emulators:exec --only firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit'",
    "test:series-locking:long": "firebase emulators:exec --only firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit --runInBand --testTimeout=240000 src/test/series/reorderSeriesItems.test.ts src/test/series/bulkAddToSeries.crossCallableLocking.test.ts'",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "catalog:",
    "@google-cloud/storage": "catalog:",
    "algoliasearch": "catalog:",
    "axios": "catalog:",
    "buffer-image-size": "^0.6.4",
    "dotenv": "^16.3.1",
    "fast-average-color-node": "^3.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "firebase-functions": "catalog:",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "catalog:",
    "google-auth-library": "catalog:",
    "headers": "catalog:",
    "https-proxy-agent": "catalog:",
    "image-size": "catalog:",
    "imagemagick": "^0.1.3",
    "lodash": "catalog:",
    "mkdirp": "catalog:",
    "node-fetch": "catalog:",
    "node-vibrant": "^4.0.3",
    "p-limit": "catalog:",
    "sharp": "0.33.5",
    "uuidv4": "^6.2.13",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/imagemagick": "^0.0.31",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.17",
    "@types/node": "catalog:",
    "@types/node-fetch": "^2.6.11",
    "@types/qs": "^6.9.11",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "catalog:",
    "firebase-functions-test": "^3.4.1",
    "globals": "^16.2.0",
    "jest": "catalog:",
    "ts-jest": "^29.4.0",
    "typescript": "catalog:"
  },
  "private": true
}
