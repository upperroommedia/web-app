{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build-watch": "tsc -w",
    "serve": "firebase emulators:start --only functions --config ../firebase.test.json",
    "shell": "firebase functions:shell --config ../firebase.test.json",
    "start": "pnpm run shell",
    "test": "firebase emulators:exec --only auth,firestore,database --config ../firebase.test.json 'pnpm exec jest --watchman=false --runInBand --forceExit'",
    "test:verbose": "VERBOSE=1 firebase emulators:exec --only auth,firestore,database --config ../firebase.test.json 'pnpm exec jest --watchman=false --runInBand --forceExit'",
    "test:series-locking:long": "firebase emulators:exec --only auth,firestore,database --config ../firebase.test.json 'pnpm exec jest --forceExit --runInBand --testTimeout=240000 src/test/series/reorderSeriesItems.test.ts src/test/series/bulkAddToSeries.crossCallableLocking.test.ts'",
    "deploy": "node -e \"console.error('Deploy split Firebase codebases from the repository root or CI workflows, not from the legacy functions package.'); process.exit(1)\"",
    "logs": "firebase functions:log --config ../firebase.json",
    "build:ci": "pnpm run build",
    "lint:ci": "pnpm run lint",
    "test:ci": "pnpm run test"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@upperroom/shared": "workspace:*",
    "@sentry/node": "^10.47.0",
    "@google-cloud/functions-framework": "catalog:",
    "@google-cloud/storage": "catalog:",
    "algoliasearch": "catalog:",
    "axios": "catalog:",
    "buffer-image-size": "catalog:",
    "dotenv": "^16.3.1",
    "fast-average-color-node": "catalog:",
    "ffmpeg-static": "catalog:",
    "ffprobe-static": "catalog:",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "firebase-functions": "catalog:",
    "@ts-ffmpeg/fluent-ffmpeg": "catalog:",
    "form-data": "catalog:",
    "google-auth-library": "catalog:",
    "headers": "catalog:",
    "https-proxy-agent": "catalog:",
    "image-size": "catalog:",
    "imagemagick": "^0.1.3",
    "lodash": "catalog:",
    "mkdirp": "catalog:",
    "node-fetch": "catalog:",
    "node-vibrant": "catalog:",
    "p-limit": "catalog:",
    "sharp": "0.33.5",
    "uuid": "catalog:",
    "ytdl-core": "catalog:"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/imagemagick": "^0.0.31",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.17",
    "@types/node": "catalog:",
    "@types/node-fetch": "^2.6.11",
    "@types/qs": "^6.9.11",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "catalog:",
    "firebase-functions-test": "^3.4.1",
    "globals": "^16.2.0",
    "jest": "catalog:",
    "ts-jest": "^29.4.0",
    "typescript": "catalog:"
  },
  "private": true
}
