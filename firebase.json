{
  "functions": [
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-core",
      "codebase": "core",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-media",
      "codebase": "media",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-image",
      "codebase": "image",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-integrations",
      "codebase": "integrations",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": [
    {
      "target": "rtdb",
      "rules": "database.rules.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": {
    "backendId": "web-staging",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".next/cache"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8081
    },
    "storage": {
      "port": 9199
    },
    "database": {
      "port": 9000
    },
    "tasks": {
      "port": 8123
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "extensions": {
    "images-index": "algolia/firestore-algolia-search@0.5.14",
    "lists-index": "algolia/firestore-algolia-search@0.5.14",
    "sermons-index": "algolia/firestore-algolia-search@0.5.14",
    "speakers-index": "algolia/firestore-algolia-search@0.5.14",
    "users-index": "algolia/firestore-algolia-search@0.5.14",
    "firestore-send-email-6emo": "firebase/firestore-send-email@0.2.6"
  }
}
