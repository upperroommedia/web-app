{
  "functions": [
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-core",
      "codebase": "core",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-media",
      "codebase": "media",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-image",
      "codebase": "image",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions-integrations",
      "codebase": "integrations",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "kit": "firestore-algolia-search",
      "source": "function-kits/firestore-algolia-search",
      "instances": {
        "images-index": "function-kits/firestore-algolia-search/config-images-index",
        "lists-index": "function-kits/firestore-algolia-search/config-lists-index",
        "sermons-index": "function-kits/firestore-algolia-search/config-sermons-index",
        "speakers-index": "function-kits/firestore-algolia-search/config-speakers-index",
        "users-index": "function-kits/firestore-algolia-search/config-users-index"
      },
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "kit": "image-processing-api",
      "source": "function-kits/image-processing-api/source",
      "instances": {
        "image-processing-api": "function-kits/image-processing-api/config-image-processing-api"
      },
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "kit": "firestore-send-email",
      "source": "function-kits/firestore-send-email",
      "instances": {
        "firestore-send-email": "function-kits/firestore-send-email/config-firestore-send-email"
      },
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "__tests__",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": [
    {
      "target": "rtdb",
      "rules": "database.rules.json"
    }
  ],
  "storage": [
    {
      "target": "default",
      "rules": "storage.rules"
    },
    {
      "target": "images",
      "rules": "storage.rules"
    }
  ],
  "apphosting": {
    "backendId": "web-staging",
    "rootDir": "apps/web",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".next",
      "output",
      "test-results"
    ],
    "alwaysDeployFromSource": true
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8081
    },
    "storage": {
      "port": 9199
    },
    "database": {
      "port": 9000
    },
    "tasks": {
      "port": 8123
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
