{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "env": ["DOCKER_BUILDKIT=1"],
      "args": [
        "build",
        "--platform",
        "linux/amd64",
        "-f",
        "apps/temporal-worker/Dockerfile",
        "--build-arg",
        "TEMPORAL_IMAGE_BUILD_ID=${_BUILD_ID}",
        "-t",
        "${_IMAGE}",
        "."
      ]
    }
  ],
  "images": ["${_IMAGE}"],
  "timeout": "1800s",
  "options": {
    "logging": "CLOUD_LOGGING_ONLY",
    "machineType": "E2_HIGHCPU_8"
  }
}
