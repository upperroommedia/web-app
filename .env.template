# Required base project selection.
# Set this manually, or let `pnpm run setup:env` choose and populate it on first bootstrap.
FIREBASE_PROJECT_ID=
FIREBASE_FUNCTIONS_REGION=us-central1
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Required Firebase web config for the Next app.
# `pnpm run setup:env` bootstraps these for a new `.env`; keep names stable for local overrides.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=
NEXT_PUBLIC_FIREBASE_IMAGES_BUCKET=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
FIREBASE_IMAGES_BUCKET=

# Required for admin/search features.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_API_KEY=

# Required for role-request and operational alert emails.
ADMIN_BASE_URL=http://localhost:3000
ROLE_REQUEST_RECIPIENTS=
RUNTIME_ALERT_RECIPIENTS=

# Required for Subsplash publish/edit/delete flows.
SUBSPLASH_EMAIL=
SUBSPLASH_PASSWORD=

# Required for SoundCloud upload/delete flows.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional local overrides.
PROCESS_AUDIO_SERVICE_URL=
PROCESS_AUDIO_TASK_TARGET_URI=
